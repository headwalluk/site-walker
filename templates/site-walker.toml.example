# site-walker provider registry.
#
# Copy this file to one of the four search paths and chmod 0600 it:
#
#   ./site-walker.toml                               (project root, development)
#   ~/.site-walker/site-walker.toml                  (per-user)
#   ~/.config/site-walker/site-walker.toml           (XDG)
#   /etc/site-walker.toml                            (system-wide)
#
# Or override with the SW_CONFIG env var:
#
#   SW_CONFIG=/path/to/site-walker.toml npm start
#
# The override is also subject to the 0600 permission gate.
# site-walker refuses to start if the resolved file is group- or
# world-readable. After editing, run:
#
#   chmod 0600 site-walker.toml
#
# Each [providers.<name>] entry defines one provider. The <name> is what
# you reference in a website's model_slug as the part before the first `/`.
#
# Supported protocols (M5 ships ollama-native only; the others land in M8):
#
#   ollama-native       — self-hosted Ollama, calls POST {base_url}/api/chat
#   anthropic           — Anthropic Messages API
#   openrouter          — OpenAI-compatible wire format, OpenRouter base URL
#   openai-compatible   — generic OpenAI-clone provider
#
# Optional flag:
#
#   is_local            — true for self-hosted backends on your own network.
#                         M11 (rate limiting) reads this to relax limits on
#                         local traffic. Defaults to false.

# Example: self-hosted Ollama on a Raspberry Pi.
[providers.pi]
protocol = "ollama-native"
base_url = "http://rpi.local:11434"
is_local = true

# Example: a second self-hosted Ollama on a laptop, available as fallback.
# [providers.laptop]
# protocol = "ollama-native"
# base_url = "http://laptop.local:11434"
# is_local = true

# Example: Anthropic cloud (Phase 2, M8).
# [providers.anthropic]
# protocol = "anthropic"
# api_key = "sk-ant-api03-REPLACE-ME"

# Example: OpenRouter (Phase 2, M8). Lets you reach many models behind one key.
# [providers.openrouter]
# protocol = "openrouter"
# api_key = "sk-or-v1-REPLACE-ME"
