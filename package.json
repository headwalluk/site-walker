{
  "name": "site-walker",
  "version": "0.22.1",
  "description": "A self-hosted, multi-tenant pre-sales chatbot API.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Paul <paul@headwall-hosting.com>",
  "homepage": "https://github.com/headwalluk/site-walker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/headwalluk/site-walker.git"
  },
  "bugs": {
    "url": "https://github.com/headwalluk/site-walker/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "concurrently --names tsc,node --kill-others-on-fail 'tsc --watch --preserveWatchOutput' 'node --env-file-if-exists=.env --watch dist/index.js'",
    "test": "npm run build && node --env-file-if-exists=.env --test 'dist/**/*.test.js'",
    "format": "prettier --write .",
    "lint": "eslint .",
    "migrate": "node --env-file-if-exists=.env ./node_modules/knex/bin/cli.js migrate:latest",
    "migrate:rollback": "node --env-file-if-exists=.env ./node_modules/knex/bin/cli.js migrate:rollback",
    "migrate:status": "node --env-file-if-exists=.env ./node_modules/knex/bin/cli.js migrate:status",
    "migrate:make": "node --env-file-if-exists=.env ./node_modules/knex/bin/cli.js migrate:make"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.8.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "commander": "^14.0.3",
    "fastify": "^5.8.5",
    "knex": "^3.2.10",
    "maxmind": "^5.0.6",
    "mysql2": "^3.22.3",
    "zod": "^4.4.3"
  }
}
