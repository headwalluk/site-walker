# site-walker — example environment file.
# Copy to .env (chmod 0600) and fill in real values. .env is gitignored.

# HTTP server.
# The dev host runs many services full-time, so we DO NOT default to common
# ports (3000, 8000, 8080, etc.). Pick an obscure port and reserve PORT+1 for
# any future port-bound test server.
PORT=47830
HOST=127.0.0.1

# MariaDB connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=site_walker
DB_USER=site_walker
DB_PASSWORD='REDACTED-DEV-DB-PASSWORD'
