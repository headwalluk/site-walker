# site-walker — example environment file.
# Copy to .env (chmod 0600) and fill in real values. .env is gitignored.
# Full operator reference for every variable: docs/env.md.

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
# The dev host runs many services full-time, so we DO NOT default to common
# ports (3000, 8000, 8080, etc.). Pick an obscure port and reserve PORT+1 for
# any future port-bound test server.
PORT=47830
HOST=127.0.0.1

# -----------------------------------------------------------------------------
# MariaDB connection
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=site_walker
DB_USER=site_walker
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# Master encryption key for chatbot BYO LLM provider API keys (M17).
# AES-256-GCM; base64-encoded 32 bytes. REQUIRED for the API server to boot.
# Generate with: ./bin/sw secrets gen-key
SW_ENCRYPTION_KEY=

# Provisioning key for the /admin/accounts/* HTTP surface (M19). Hashed at
# boot, constant-time compared against incoming bearer. Used by
# site-walker-for-woo to create accounts + mint account admin keys.
# Generate with: ./bin/sw secrets gen-provisioning-key
# Unset = /admin/accounts/* always returns 401 bearer_invalid.
# SW_PROVISIONING_KEY=sw_paste-base64url-32-bytes-here

# -----------------------------------------------------------------------------
# Geo-blocking
# -----------------------------------------------------------------------------
# Set GEOIP_DB_PATH to a MaxMind GeoIP2 / GeoLite2 country database.
# Required if any chatbot is configured with a non-allowall mode.
# GEOIP_DB_PATH=/var/lib/GeoIP/GeoLite2-Country.mmdb

# -----------------------------------------------------------------------------
# Runtime mode
# -----------------------------------------------------------------------------
# Defaults to "production" if unset (the tighter mode). Set to "development"
# to allow private/loopback IPs through geo-blocking AND to permit the
# SW_SIM_* acceptance-testing hooks below (production refuses to start when
# any SW_SIM_* var is set).
# NODE_ENV=development

# -----------------------------------------------------------------------------
# Budget cap sanity bounds (M20)
# -----------------------------------------------------------------------------
# Hard upper bounds on chatbots.daily_budget_usd and chatbots.session_budget_usd
# (the latter also bounds admin_session_budget_usd). The admin PATCH endpoint
# and `sw chatbot set-budget` refuse values above these. Catches typos and
# limits the blast radius of a stolen admin key. Raise only if needed.
# SW_MAX_DAILY_BUDGET_USD=10000
# SW_MAX_SESSION_BUDGET_USD=100

# -----------------------------------------------------------------------------
# Rate limiting (M23) — defaults shown, per-minute fixed-window caps
# -----------------------------------------------------------------------------
# Set SW_RATELIMIT_ENABLED=false to take the whole subsystem offline
# (handy in dev/test). Tune the caps based on real traffic data; the
# defaults are conservative.
# SW_RATELIMIT_ENABLED=true
# SW_RATELIMIT_SESSIONS_PER_IP_PER_MINUTE=10
# SW_RATELIMIT_SESSIONS_PER_CHATBOT_PER_MINUTE=60
# SW_RATELIMIT_CHAT_PER_IP_PER_MINUTE=20
# SW_RATELIMIT_CHAT_PER_CHATBOT_PER_MINUTE=120

# -----------------------------------------------------------------------------
# Acceptance-testing simulation hooks (M23.5 / M23.6) — FORBIDDEN IN PRODUCTION
# -----------------------------------------------------------------------------
# The whole SW_SIM_* namespace is reserved for "force this scenario" hooks
# used during acceptance testing. The server refuses to boot if NODE_ENV is
# production AND any SW_SIM_* var is set — name an offender and exit. To use
# these, set NODE_ENV to a non-production value (development/staging/test).
#
# SW_SIM_SOFT_HANDOFF_AFTER_USER_TURNS: integer. When set, the HANDOFF_SOFT.md
#   block injects whenever the session has reached this many user-role messages
#   (real spend trigger still applies in parallel — whichever fires first).
# SW_SIM_HARD_HANDOFF_AFTER_USER_TURNS: integer. When set, the session
#   hard-terminates (+ webhook fires) after this many user-role messages.
#   M23.6 final-turn wind-down hint (HANDOFF_FINAL) fires on the same turn.
#
# Sanity guard: refuses to boot when both set and SOFT >= HARD.
# SW_SIM_SOFT_HANDOFF_AFTER_USER_TURNS=5
# SW_SIM_HARD_HANDOFF_AFTER_USER_TURNS=7
